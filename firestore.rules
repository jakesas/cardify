rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Per-user data isolation: every user can only access their own data
    match /users/{uid} {
      // Allow users to read/write their own user document
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Decks subcollection
      match /decks/{deckId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Cards subcollection
      match /cards/{cardId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Reviews subcollection
      match /reviews/{reviewId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Sync state document
      match /syncState/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---- Public Study Library ----
    // Public read; authenticated users publish; authors manage their own docs.
    // Non-owners may only bump views/imports counters (not edit content).
    match /library-resources/{docId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['views', 'importsCount']));
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // ---- Community shared decks ----
    // Public browsing; authors own their uploads; anyone bumps the download count.
    match /shared-decks/{deckId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid
            || request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['downloads']));
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // ---- Study Groups ----
    // Logged-in users can join and participate; creator owns the group document.
    match /groups/{groupId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.createdBy == request.auth.uid;
    }
    match /group-members/{memberId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.role == 'admin');
    }
    match /group-decks/{deckId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}