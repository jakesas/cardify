# Client-side (Vite) — required
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Groq AI API
# Development: set VITE_GROQ_API_KEY in .env (client-side, for local dev only)
# Production: DON'T set VITE_GROQ_API_KEY. Instead set GROQ_API_KEY (no VITE_ prefix)
# in the Vercel dashboard so the key stays server-side inside the /api/groq proxy.
VITE_GROQ_API_KEY=

# Xendit payment — NOT INTEGRATED (no backend deployed).
# The pay screen is an honor-system gate; set VITE_XENDIT_INVOICE_API if you
# add a serverless function later. Do not add auth checks relying on it.
# VITE_XENDIT_INVOICE_API=/api/create-invoice
# XENDIT_SECRET_KEY=

# Flashcard cache (Upstash Redis) — optional but strongly recommended.
# Go to https://upstash.com → Create Redis database (free tier is plenty).
# Copy the REST URL and REST Token into your Vercel environment variables.
# Without these, the cache is skipped (API still works, just no dedup).
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxx
