{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "oauth:allow-start",
    "oauth:allow-cancel",
    "opener:default"
  ]
}
